# ===== LINE（必須）=====
# https://developers.line.biz/console/ で取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# グループID（BOTをグループに入れて、一度メッセージを送るとログに出ます）
# 例: Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_GROUP_ID=

# ===== OpenAI（任意・後からでOK）=====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=xhigh
OPENAI_VECTOR_STORE_ID=
# 公開情報が必要な質問で自動Web検索（社内ログ/資料は検索処理に渡さない）
OPENAI_WEB_SEARCH_ENABLED=1
# 休み希望の保存用Conversation（通常のAI会話・Vector Storeとは分ける）
OPENAI_SHIFT_CONVERSATION_ID=

# 毎朝8時の出勤者+発送件数。接続/資料/LINEの検証後に1へ変更する。
MORNING_NOTIFICATION_ENABLED=0
GMAIL_IMAP_USER=
# 通常のGoogleパスワードではなく、ユーザー本人が作成するアプリパスワード。
GMAIL_IMAP_PASSWORD=
YAHOO_IMAP_USER=
YAHOO_IMAP_PASSWORD=
# 対象メールが受信箱以外へ移動される場合は明示的に変更する。
GMAIL_IMAP_FOLDER=INBOX
YAHOO_IMAP_FOLDER=INBOX

# 設定変更を許可する管理者のLINE userId（表示名ではなくuserId）
ADMIN_LINE_USER_ID=

# ===== 運用 =====
# Cronから叩くときの合言葉（自分で決める適当な文字列）
# クラウドでは cron-job.org の URL にも同じ値を入れる
CRON_SECRET=change-me-to-random-string

# タイムゾーン（Render でも推奨）
TZ=Asia/Tokyo
# クラウドの集計更新を1プロセスで直列化し、AI応答時間を確保する
GUNICORN_CMD_ARGS=--workers 1 --threads 4 --timeout 90

# ポート（ローカル用。クラウドは自動で PORT が入る）
PORT=8000

# データ保存先（通常は不要。Render Disk を使うときだけ）
# DATA_DIR=/var/data
